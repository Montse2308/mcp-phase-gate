{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/mcp-phase-gate@4/schema/machine.json",
  "title": "machine.json",
  "description": "Configuración de mcp-phase-gate en este equipo: las rutas de la Documentación y de los repos, la ruta propia de cada repo, el preset por defecto para proyectos sin manifiesto y el idioma por defecto. Vive en la carpeta de configuración de este equipo, no en la Documentación.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "enum": [
        1,
        2
      ]
    },
    "rutas": {
      "type": "object",
      "properties": {
        "documentacion": {
          "type": "string",
          "minLength": 1
        },
        "carpetaDeRepos": {
          "type": "string",
          "minLength": 1
        },
        "subcarpetaTareas": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "repos": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[^/\\\\]+\\/[a-z0-9][a-z0-9-]{0,39}$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "presetPorDefecto": {
      "type": "string"
    },
    "idiomaPorDefecto": {
      "type": "string",
      "enum": [
        "es",
        "en"
      ]
    }
  },
  "required": [
    "version"
  ],
  "additionalProperties": false
}
