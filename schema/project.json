{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/mcp-phase-gate@3/schema/project.json",
  "title": "phase-gate.json",
  "description": "Manifiesto de un proyecto de mcp-phase-gate: preset, idioma, repositorios y reglas. Vive en <DOCS>/<PROYECTO>/phase-gate.json.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "preset": {
      "default": "software",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
    },
    "idioma": {
      "default": "es",
      "type": "string",
      "enum": [
        "es"
      ]
    },
    "repos": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
          },
          "dir": {
            "type": "string",
            "minLength": 1
          },
          "rol": {
            "type": "string",
            "maxLength": 60
          }
        },
        "required": [
          "id",
          "dir"
        ],
        "additionalProperties": false
      }
    },
    "reglas": {
      "default": {},
      "type": "object",
      "properties": {
        "lotes": {
          "type": "boolean"
        },
        "commits": {
          "type": "string",
          "enum": [
            "agente-commitea-con-OK",
            "agente-propone",
            "auto",
            "ninguno"
          ]
        },
        "verificacion": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "fase5": {
      "default": {},
      "type": "object",
      "properties": {
        "prPorRepo": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "version"
  ],
  "additionalProperties": false
}
