{
  "name": "mcp-phase-gate",
  "version": "3.0.0",
  "description": "Servidor MCP que parte cada requerimiento en cinco fases con compuerta y obliga a que cada una deje su documento en una documentación central.",
  "main": "build/index.js",
  "bin": {
    "mcp-phase-gate": "build/index.js"
  },
  "files": [
    "build",
    "prompts",
    "presets",
    "schema",
    "studio/dist",
    "!build/**/*.map"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && tsc -p studio/tsconfig.json && vite build --config studio/vite.config.ts && node scripts/presupuesto-studio.mjs",
    "start": "node build/index.js",
    "dev": "tsc --watch",
    "test": "tsc -p tsconfig.test.json && node --test \"build-test/test/**/*.test.js\"",
    "test:e2e": "playwright test -c studio/playwright.config.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Montse2308/mcp-phase-gate.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "phase-gate",
    "workflow",
    "documentation",
    "cursor",
    "claude-code"
  ],
  "author": "Montserrat Ximena Hernández Gallegos",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Montse2308/mcp-phase-gate/issues"
  },
  "homepage": "https://github.com/Montse2308/mcp-phase-gate#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "^25.9.1",
    "axe-core": "4.13.0",
    "dompurify": "3.4.16",
    "marked": "18.0.14",
    "preact": "10.29.8",
    "typescript": "^6.0.3",
    "vite": "8.3.1"
  }
}
